rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Session limit: at most 4 active sessions per account
    match /activeSessions/{userId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['sessions'])
        && request.resource.data.sessions is map
        && request.resource.data.sessions.size() <= 4;

      allow delete: if false;
    }

    function signedIn() {
      return request.auth != null;
    }

    // Replace these with your own Firebase Authentication user IDs
    function isOwner() {
      return signedIn()
        && request.auth.uid == 'Xo2vTmq0NxWkSEo1RQnDzHqtMEo2';
    }

    function isESP32() {
      return signedIn()
        && request.auth.uid == 'sW1Mqze9qqPOXehpdpMrgHBlSLz1';
    }

    // Fields this write is changing
    function changedKeys() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys();
    }

    // True if field 'k' is not being changed, or is being changed to a bool
    function boolOrUnchanged(k) {
      return !changedKeys().hasAny([k])
        || request.resource.data[k] is bool;
    }

    // True if field 'k' is not being changed, or is a number from 5 to 299
    function secondsOrUnchanged(k) {
      return !changedKeys().hasAny([k])
        || (request.resource.data[k] is number
            && request.resource.data[k] >= 5
            && request.resource.data[k] <= 299);
    }

    match /irrigation/{irrigationId} {
      allow read: if irrigationId == 'BU6dFZs4xNrXGgdJWNle'
        && (isOwner() || isESP32());

      allow update: if irrigationId == 'BU6dFZs4xNrXGgdJWNle'
        && (
          // ---------- WEBSITE (owner) ----------
          (
            isOwner()
            && changedKeys().hasOnly([
              'pump',
              'mode',
              'timerSeconds',
              'timerRunning',
              'scheduleEnabled',
              'scheduleTime',
              'scheduleDurationSeconds',
              'scheduleDays'
            ])
            && boolOrUnchanged('pump')
            && (
              !changedKeys().hasAny(['mode'])
              || request.resource.data.mode in ['AUTO', 'MANUAL', 'TIMER', 'SCHEDULE']
            )
            && secondsOrUnchanged('timerSeconds')
            && boolOrUnchanged('timerRunning')
            && boolOrUnchanged('scheduleEnabled')
            && secondsOrUnchanged('scheduleDurationSeconds')
            && (
              // "HH:MM", 24-hour clock, e.g. "06:30"
              !changedKeys().hasAny(['scheduleTime'])
              || (request.resource.data.scheduleTime is string
                  && request.resource.data.scheduleTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
            )
            && (
              // "DAILY" or weekday numbers like "1,3,5" (0 = Sunday)
              !changedKeys().hasAny(['scheduleDays'])
              || (request.resource.data.scheduleDays is string
                  && request.resource.data.scheduleDays.matches('^(DAILY|[0-6](,[0-6])*)$'))
            )
          )
          ||
          // ---------- ESP32 ----------
          (
            isESP32()
            && changedKeys().hasOnly([
              'soilMoisture',
              'timestamp',
              'pump',
              'temperature',
              'humidity',
              'timerRunning',
              'scheduleRunning',
              'rainChance',
              'rainSkip',
              'rainTest'
            ])
            && (
              !changedKeys().hasAny(['soilMoisture'])
              || (
                request.resource.data.soilMoisture is number
                && request.resource.data.soilMoisture >= 0
                && request.resource.data.soilMoisture <= 100
              )
            )
            && (
              !changedKeys().hasAny(['timestamp'])
              || request.resource.data.timestamp is timestamp
            )
            && boolOrUnchanged('pump')
            && boolOrUnchanged('timerRunning')
            && boolOrUnchanged('scheduleRunning')
            && (
              !changedKeys().hasAny(['temperature'])
              || (
                request.resource.data.temperature is number
                && request.resource.data.temperature >= -40
                && request.resource.data.temperature <= 80
              )
            )
            && (
              !changedKeys().hasAny(['humidity'])
              || (
                request.resource.data.humidity is number
                && request.resource.data.humidity >= 0
                && request.resource.data.humidity <= 100
              )
            )
            && (
              // -1 = no forecast yet, otherwise 0-100 %
              !changedKeys().hasAny(['rainChance'])
              || (
                request.resource.data.rainChance is int
                && request.resource.data.rainChance >= -1
                && request.resource.data.rainChance <= 100
              )
            )
            && boolOrUnchanged('rainSkip')
            && boolOrUnchanged('rainTest')
          )
        );
    }

    match /irrigationReadings/{readingId} {
      allow read: if isOwner();

      allow create: if isESP32()
        && request.resource.data.keys().hasAll([
          'soilMoisture',
          'pump',
          'mode',
          'timestamp'
        ])
        && request.resource.data.keys().hasOnly([
          'soilMoisture',
          'pump',
          'mode',
          'timestamp',
          'savedOffline'
        ])
        && request.resource.data.soilMoisture is number
        && request.resource.data.soilMoisture >= 0
        && request.resource.data.soilMoisture <= 100
        && request.resource.data.pump is bool
        && request.resource.data.mode in ['AUTO', 'MANUAL', 'TIMER', 'SCHEDULE']
        && request.resource.data.timestamp is timestamp
        && (
          !('savedOffline' in request.resource.data)
          || request.resource.data.savedOffline is bool
        );

      allow update, delete: if false;
    }
  }
}
